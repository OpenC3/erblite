  {
    "name": "nested_across_tags",
    "template": "<%- {a: [1, 2], b: [3]}.each do |k, vs| -%>\n<%= k %>:\n<%- vs.each do |v| -%>\n  - <%= v %>\n<%- end -%>\n<%- end -%>\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "a:\n  - 1\n  - 2\nb:\n  - 3\n"
  },
