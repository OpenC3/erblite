[
  {
    "name": "plain_text",
    "template": "hello world",
    "vars": {},
    "ruby_compatible": true,
    "expected": "hello world"
  },
  {
    "name": "empty",
    "template": "",
    "vars": {},
    "ruby_compatible": true,
    "expected": ""
  },
  {
    "name": "output_tag",
    "template": "a<%= 1 + 2 %>b",
    "vars": {},
    "ruby_compatible": true,
    "expected": "a3b"
  },
  {
    "name": "code_tag_no_output",
    "template": "a<% x = 5 %>b<%= x %>",
    "vars": {},
    "ruby_compatible": true,
    "expected": "ab5"
  },
  {
    "name": "comment_tag",
    "template": "a<%# this is ignored %>b",
    "vars": {},
    "ruby_compatible": true,
    "expected": "ab"
  },
  {
    "name": "comment_multiline",
    "template": "a<%# line1\nline2 %>b",
    "vars": {},
    "ruby_compatible": true,
    "expected": "ab"
  },
  {
    "name": "escaped_open",
    "template": "<%% literal %%> <%= 1 %>",
    "vars": {},
    "ruby_compatible": true,
    "expected": "<% literal %%> 1"
  },
  {
    "name": "newline_kept",
    "template": "<% x = 1 %>\nA\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "\nA\n"
  },
  {
    "name": "trim_close",
    "template": "<% x = 1 -%>\nA\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "A\n"
  },
  {
    "name": "trim_open",
    "template": "  <%- x = 1 -%>\nA\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "A\n"
  },
  {
    "name": "trim_open_not_at_line_start",
    "template": "B  <%- x = 1 -%>\nA\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "B  A\n"
  },
  {
    "name": "trim_output_close",
    "template": "<%= 1 -%>\n<%= 2 -%>\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "12"
  },
  {
    "name": "trim_comment",
    "template": "a\n<%# c -%>\nb",
    "vars": {},
    "ruby_compatible": true,
    "expected": "a\nb"
  },
  {
    "name": "trim_tab_indent",
    "template": "\t\t<%- if true -%>\nyes\n\t\t<%- end -%>\n",
