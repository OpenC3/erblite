    "ruby_compatible": true,
    "expected": "yes\n"
  },
  {
    "name": "trim_crlf",
    "template": "<% x = 1 -%>\r\nA",
    "vars": {},
    "ruby_compatible": true,
    "expected": "A"
  },
  {
    "name": "loop_across_tags",
    "template": "<% [1, 2, 3].each do |i| -%>\n  item <%= i %>\n<% end -%>\ndone\n",
    "vars": {},
    "ruby_compatible": true,
    "expected": "  item 1\n  item 2\n  item 3\ndone\n"
  },
  {
    "name": "loop_across_tags_brace",
    "template": "<% [1, 2].each { |i| %>[<%= i %>]<% } %>",
    "vars": {},
    "ruby_compatible": true,
    "expected": "[1][2]"
  },
  {
    "name": "if_across_tags",
    "template": "<% if true %>T<% else %>F<% end %>",
